{
  "palette": "default",
  "bar": {
    "height": 34,
    "margin": 12,
    "left": [
      "session",
      "workspaces",
      "keyboard",
      "battery"
    ],
    "center": [
      "clock",
      "media"
    ],
    "right": [
      "tray",
      "network",
      "notifications"
    ],
    "panelAt": {
      "left": "edge-left",
      "center": "pill",
      "right": "edge-right"
    }
  },
  "panels": {},
  "workspaces": {
    "persistent": 6
  },
  "keyboard": {
    "names": {
      "English (US)": "EN",
      "Russian": "RU",
      "Ukrainian": "UA"
    }
  },
  "clock": {
    "format": "HH:mm"
  },
  "dashboard": {
    "left": [
      "cpu",
      "gpu",
      "memory"
    ],
    "right": [
      "weather",
      "forecast"
    ],
    "weekStart": "monday",
    "weekNumbers": true
  },
  "weather": {
    "latitude": 50.45,
    "longitude": 30.52,
    "units": "metric"
  },
  "network": {
    "showSpeed": false
  },
  "media": {
    "maxWidth": 240
  },
  "launcher": {
    "maxResults": 50
  },
  "clipboard": {
    "maxItems": 500
  },
  "notifications": {
    "defaultTimeout": 5000,
    "criticalSticky": true,
    "dndAllowCritical": true,
    "historyLimit": 100,
    "maxToasts": 5,
    "monitor": "focused",
    "toastWidth": 380,
    "bodyMaxLines": 4,
    "centerWidth": 420
  },
  "lock": {
    "useQuickshell": true,
    "command": "hyprlock",
    "pamConfig": "login",
    "screencopy": true
  },
  "session": {
    "dryRun": false,
    "lockBeforeSuspend": true,
    "confirmTimeout": 3000
  },
  "sysstats": {
    "interval": 2000,
    "gpuInterval": 10000
  },
  "timers": {}
}
